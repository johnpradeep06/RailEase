DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/irctc
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
FRONTEND_ORIGINS=http://localhost:3000

# How long a pending booking keeps its seats locked while the customer pays.
# Use 1-2 to demo the expiry quickly.
SEAT_LOCK_MINUTES=10

# Razorpay TEST-mode keys (Dashboard -> Account & Settings -> API Keys, test mode).
# Leave RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET blank to fall back to the mock gateway.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only needed if you register the webhook (Dashboard -> Webhooks) pointing at
#   https://<backend>/payments/razorpay/webhook   with events payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=
